<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Regression Suite" parallel="tests" thread-count="10">
    <listeners>
        <listener class-name="listeners.TestListener"></listener>
    </listeners>

    <test name="Postpaid tests">
        <classes>
            <class name="tests.LogoutTest"/>
            <class name="tests.OrangeHRMValidLogin"></class>
            <class name="tests.AdminSystemUserFind"></class>
            <class name="tests.DeleteAdminUser"></class>
            <class name="tests.ForgotPassword"></class>
            <class name="tests.EmployeeSearchPIM"></class>
            <class name="tests.ActionsOrange"></class>
            <class name="tests.WindowsHandling"></class>
        </classes>

    </test>

</suite>